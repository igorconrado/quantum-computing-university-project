# IBM Quantum Platform Credentials
# Copy this file to .env and fill in your credentials
# NEVER commit .env to version control!

# API Token (44 characters) - Get from https://quantum.cloud.ibm.com
IQP_API_TOKEN=your_api_token_here

# Instance CRN (optional) - Get from https://quantum.cloud.ibm.com/instances
IBM_QUANTUM_CRN=crn:v1:bluemix:public:quantum-computing:...

# Region (optional, defaults to us-east)
IBM_QUANTUM_REGION=us-east
